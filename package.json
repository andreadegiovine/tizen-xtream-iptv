{
  "name": "xtream-iptv",
  "version": "0.1.0",
  "description": "Netflix-style Xtream Codes IPTV client for Samsung Tizen TVs",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "chrome 76"
  ],
  "scripts": {
    "dev": "webpack serve --mode development",
    "dev:tv": "webpack serve --mode development --env webapis",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,scss,json}\" \"test/**/*.js\"",
    "tizen:dev-shell": "node scripts/make-dev-shell.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "globals": {
      "__DEV__": false,
      "__APP_VERSION__": "test"
    },
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@eslint/js": "^9.0.0",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.0",
    "sass": "^1.80.0",
    "sass-loader": "^16.0.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2"
  }
}
