{
  "name": "xtream-iptv",
  "version": "0.1.0",
  "description": "Xtream Codes IPTV client for Samsung Tizen TVs",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "chrome 76"
  ],
  "scripts": {
    "dev": "webpack serve --mode development",
    "dev:webos": "webpack serve --mode development --env platform=webos",
    "desktop": "npm run build:desktop && npx --yes electron@44.9.3 platforms/desktop/electron/main.js",
    "build": "webpack --mode production",
    "build:tizen": "webpack --mode production --env platform=tizen",
    "build:webos": "webpack --mode production --env platform=webos",
    "build:desktop": "webpack --mode production --env platform=desktop",
    "build:android": "webpack --mode production --env platform=android",
    "postbuild": "node scripts/check-dist.js",
    "postbuild:tizen": "node scripts/check-dist.js",
    "postbuild:webos": "node scripts/check-dist.js",
    "postbuild:desktop": "node scripts/check-dist.js",
    "postbuild:android": "node scripts/check-dist.js",
    "test": "jest",
    "lint": "eslint .",
    "mock": "node scripts/mock-xtream/server.js",
    "perf": "node scripts/mock-xtream/perf.js",
    "perf:compare": "node scripts/mock-xtream/compare.js",
    "format": "prettier --write \"src/**/*.{js,scss,json}\" \"test/**/*.js\"",
    "screenshots": "node scripts/screenshots.js",
    "store-assets": "node scripts/store-assets.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/test/setup.js"
    ],
    "globals": {
      "__DEV__": false,
      "__APP_VERSION__": "test",
      "__PLATFORM__": "tizen",
      "__JS_DEMUX__": true
    },
    "transform": {
      "\\.js$": "babel-jest",
      "\\.svg$": "<rootDir>/test/svgTransform.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/platforms/android/node_modules",
      "<rootDir>/platforms/android/android"
    ],
    "moduleNameMapper": {
      "^@platform$": "<rootDir>/platforms/tizen/platform.js"
    },
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@eslint/js": "^9.0.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "autoprefixer": "^10.4.20",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.0.0",
    "hls.js": "^1.5.20",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.1",
    "mpegts.js": "^1.7.3",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.0",
    "sass": "^1.80.0",
    "sass-loader": "^16.0.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "qrcode-generator": "^1.4.4"
  },
  "updates": {
    "minShell": "0.0.0"
  }
}
