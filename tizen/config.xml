<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://xtream-iptv.local/XtrmIptv01" version="__VERSION__" viewmodes="maximized">
  <tizen:application id="XtrmIptv01.XtreamIPTV" package="XtrmIptv01" required_version="6.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>Xtream IPTV</name>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/network.get"/>
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:privilege name="http://tizen.org/privilege/network.public"/>
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>
  <!-- The trailer player is an iframe on http://localhost:8125 (see the ytresolver service below). -->
  <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval'; frame-src * http://localhost:8125; connect-src *;</tizen:content-security-policy>
  <tizen:allow-mixed-content>true</tizen:allow-mixed-content>
  <tizen:service id="XtrmIptv01.ytresolver" type="service">
    <tizen:content src="service/service.js"/>
    <tizen:name>ytresolver</tizen:name>
    <tizen:description>Serves the YouTube player page for trailers</tizen:description>
  </tizen:service>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
